# DataSift KPI Bot — Environment Configuration
# Copy this file to .env in the same directory and fill in your actual values.
# DO NOT commit .env to version control or share it — it contains secrets.

# Your Google Sheet ID (the long string in the sheet URL between /d/ and /edit)
# Example URL: https://docs.google.com/spreadsheets/d/16NtvfYw_90MkarBcd2nnCHdVUxW72y1mRCq8S16tg2s/edit
# Spreadsheet ID would be: 16NtvfYw_90MkarBcd2nnCHdVUxW72y1mRCq8S16tg2s
KPI_SPREADSHEET_ID=

# Your Slack incoming webhook URL
# Example: https://hooks.slack.com/services/YOUR-TEAM-ID/YOUR-CHANNEL-ID/YOUR-WEBHOOK-TOKEN
KPI_SLACK_WEBHOOK_URL=

# Path to your Google service account JSON file
# Default: service_account.json in this same folder
KPI_SERVICE_ACCOUNT_FILE=service_account.json

# Your company name — shows up in the Slack message header
KPI_COMPANY_NAME=Your Company Name
