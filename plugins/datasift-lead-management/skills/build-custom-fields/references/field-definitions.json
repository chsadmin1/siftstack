{
  "groups": [
    { "order": 1, "name": "Qualifying Questions", "description": "Establish lead temperature, timeline, motivation, and price expectations." },
    { "order": 2, "name": "Property Condition - General", "description": "Capture the lead manager's overall read on condition during the call." },
    { "order": 3, "name": "CapEx Assessment", "description": "Most critical for underwriting. Unknown forces Full Gut scenario." },
    { "order": 4, "name": "Property Debts & Encumbrances", "description": "Every debt comes directly off MAO dollar-for-dollar." },
    { "order": 5, "name": "Title & Ownership", "description": "Confirms right person and title complications." },
    { "order": 6, "name": "Deal Intelligence", "description": "Pricing context and negotiation intelligence." },
    { "order": 7, "name": "Appointment & Next Steps", "description": "Access logistics and field visit status." }
  ],
  "fields": [
    { "group_order": 1, "label": "Seller Timeline", "field_type": "select", "placeholder": "When does the seller need to sell", "options": ["ASAP (0-30 days)", "1-3 months", "3-6 months", "6+ months", "Just exploring"] },
    { "group_order": 1, "label": "Reason for Selling", "field_type": "select", "placeholder": "Primary motivation for selling", "options": ["Financial hardship", "Divorce", "Inherited", "Tired landlord", "Job relocation", "Downsizing", "Estate/probate", "Behind on payments", "Pre-foreclosure", "Other"] },
    { "group_order": 1, "label": "Asking Price", "field_type": "number", "placeholder": "Seller's stated price expectation (raw number, no formatting)" },
    { "group_order": 1, "label": "Is Price Flexible?", "field_type": "select", "placeholder": "How firm is the seller on price", "options": ["Yes, very flexible", "Somewhat flexible", "Firm on price", "Unknown"] },
    { "group_order": 1, "label": "Other Offers Received?", "field_type": "select", "placeholder": "Have they received offers from other buyers", "options": ["Yes", "No", "Unknown"] },
    { "group_order": 1, "label": "Other Offer Amount", "field_type": "number", "placeholder": "If yes above - what amount were they offered" },
    { "group_order": 1, "label": "Previously Listed with Agent?", "field_type": "select", "placeholder": "Listing history", "options": ["Yes", "No", "Currently Listed"] },
    { "group_order": 1, "label": "What Happens After They Sell?", "field_type": "select", "placeholder": "Where is the seller going after the sale", "options": ["Moving out of area", "Needs to find new home first", "Moving into assisted living", "Has another property", "Tenant property", "Nothing holding them back", "Unknown"] },

    { "group_order": 2, "label": "Overall Condition", "field_type": "select", "placeholder": "General condition rating", "options": ["Excellent (move-in ready)", "Good (minor cosmetics only)", "Fair (needs updating)", "Poor (significant work needed)", "Distressed", "Unknown"] },
    { "group_order": 2, "label": "Interior Condition Notes", "field_type": "text", "placeholder": "What seller says about inside: flooring, kitchen, bathrooms, paint, fixtures, smell, etc." },
    { "group_order": 2, "label": "Exterior Condition Notes", "field_type": "text", "placeholder": "Roof visible issues, paint, landscaping, foundation cracks, windows, siding" },
    { "group_order": 2, "label": "Vacancy Status", "field_type": "select", "placeholder": "Is the property occupied", "options": ["Owner-occupied", "Vacant", "Tenant-occupied", "Unknown"] },
    { "group_order": 2, "label": "If Tenant - Lease Status", "field_type": "select", "placeholder": "Tenant lease type if applicable", "options": ["Month-to-month", "Active lease (note end date)", "No lease", "Unknown", "N/A"] },
    { "group_order": 2, "label": "Junk / Debris Present?", "field_type": "select", "placeholder": "Junk/debris volume", "options": ["Yes - significant", "Yes - minor", "No", "Unknown"] },
    { "group_order": 2, "label": "Soft Floors / Water Damage?", "field_type": "select", "placeholder": "Water damage indicators", "options": ["Yes - mentioned by seller", "Suspected", "No", "Unknown"] },
    { "group_order": 2, "label": "Prior Flooding or Mold?", "field_type": "select", "placeholder": "History of flooding or mold", "options": ["Yes", "No", "Unknown"] },
    { "group_order": 2, "label": "Year of Last Major Update", "field_type": "text_input", "placeholder": "Seller's stated year of last renovation (e.g., kitchen done in 2018)" },
    { "group_order": 2, "label": "Photos Obtained?", "field_type": "select", "placeholder": "Photo collection status", "options": ["Yes - uploaded to record", "Yes - in text/email", "No", "Scheduled"] },

    { "group_order": 3, "label": "Roof Condition", "field_type": "select", "placeholder": "Condition of the roof", "options": ["Insurable", "Needs Replacement", "Recently Replaced", "Unknown"] },
    { "group_order": 3, "label": "Roof Age (Years)", "field_type": "number", "placeholder": "Seller's stated age or year replaced" },
    { "group_order": 3, "label": "Roof Notes", "field_type": "text_input", "placeholder": "Material type, visible damage, seller's exact words" },
    { "group_order": 3, "label": "HVAC Condition", "field_type": "select", "placeholder": "Condition of the HVAC system", "options": ["Working", "Insurable", "Needs Replacement", "Unknown"] },
    { "group_order": 3, "label": "HVAC Age (Years)", "field_type": "number", "placeholder": "Seller's stated age or year replaced" },
    { "group_order": 3, "label": "HVAC Notes", "field_type": "text_input", "placeholder": "Brand, whether it heats/cools, any known issues" },
    { "group_order": 3, "label": "Water Heater Condition", "field_type": "select", "placeholder": "Condition of the water heater", "options": ["Working", "Needs Replacement", "Recently Replaced", "Unknown"] },
    { "group_order": 3, "label": "Water Heater Age (Years)", "field_type": "number", "placeholder": "Seller's stated age or year replaced" },
    { "group_order": 3, "label": "Water Heater Notes", "field_type": "text_input", "placeholder": "Gas vs. electric, any leaks, tankless or tank" },
    { "group_order": 3, "label": "Plumbing Condition", "field_type": "select", "placeholder": "Condition of the plumbing", "options": ["No Known Issues", "Known Issues", "Needs Full Replacement", "Unknown"] },
    { "group_order": 3, "label": "Plumbing Type", "field_type": "select", "placeholder": "Material of plumbing lines", "options": ["Copper", "PVC", "Galvanized", "Unknown"] },
    { "group_order": 3, "label": "Plumbing Notes", "field_type": "text_input", "placeholder": "Any leaks, prior repairs, cast iron drain lines, etc." },
    { "group_order": 3, "label": "Electrical Condition", "field_type": "select", "placeholder": "Condition of the electrical system", "options": ["No Known Issues", "Known Issues", "Needs Panel Upgrade", "Unknown"] },
    { "group_order": 3, "label": "Panel Type", "field_type": "select", "placeholder": "Type of electrical panel", "options": ["Breaker panel", "Fuse box", "Updated recently", "Unknown"] },
    { "group_order": 3, "label": "Electrical Notes", "field_type": "text_input", "placeholder": "Any known hazards, knob-and-tube, aluminum wiring, etc." },
    { "group_order": 3, "label": "Junk Removal Needed?", "field_type": "select", "placeholder": "Volume of junk to remove", "options": ["Yes - significant (est. $3,000-$5,000+)", "Yes - minor (est. $1,500)", "No", "Unknown"] },
    { "group_order": 3, "label": "Junk Removal Notes", "field_type": "text_input", "placeholder": "Describe what's left: furniture, personal property, debris, vehicles, etc." },

    { "group_order": 4, "label": "Mortgage Balance", "field_type": "number", "placeholder": "Seller's stated balance (approximate is fine)" },
    { "group_order": 4, "label": "Mortgage Status", "field_type": "select", "placeholder": "Current status of mortgage payments", "options": ["Current", "Behind 1-3 months", "Behind 4-6 months", "Behind 6+ months", "No mortgage", "Unknown"] },
    { "group_order": 4, "label": "Back Taxes Owed?", "field_type": "select", "placeholder": "Are there unpaid property taxes", "options": ["Yes", "No", "Unknown"] },
    { "group_order": 4, "label": "Back Taxes Amount", "field_type": "number", "placeholder": "Seller's stated amount or rough estimate" },
    { "group_order": 4, "label": "HOA?", "field_type": "select", "placeholder": "Is there an HOA", "options": ["Yes", "No", "Unknown"] },
    { "group_order": 4, "label": "HOA Monthly Amount", "field_type": "number", "placeholder": "Monthly dues amount" },
    { "group_order": 4, "label": "HOA Arrears?", "field_type": "select", "placeholder": "Behind on HOA dues", "options": ["Yes", "No", "Unknown"] },
    { "group_order": 4, "label": "HOA Arrears Amount", "field_type": "number", "placeholder": "Amount behind on HOA" },
    { "group_order": 4, "label": "Code Violations or Liens?", "field_type": "select", "placeholder": "Code violations, liens, judgments", "options": ["Yes", "No", "Unknown"] },
    { "group_order": 4, "label": "Code Violation Notes", "field_type": "text_input", "placeholder": "What violations, estimated cost to cure" },
    { "group_order": 4, "label": "Open or Unpermitted Work?", "field_type": "select", "placeholder": "Work done without permits", "options": ["Yes", "No", "Unknown"] },
    { "group_order": 4, "label": "Unpermitted Work Notes", "field_type": "text_input", "placeholder": "What was done without permit" },
    { "group_order": 4, "label": "Probate / Estate Situation?", "field_type": "select", "placeholder": "Probate or estate status", "options": ["Yes - active probate", "Yes - estate (no probate filed yet)", "No", "Unknown"] },
    { "group_order": 4, "label": "Probate Notes", "field_type": "text_input", "placeholder": "Attorney involved? Multiple heirs? Court timeline?" },
    { "group_order": 4, "label": "Foreclosure Filed?", "field_type": "select", "placeholder": "Is foreclosure filed", "options": ["Yes", "No", "Unknown"] },
    { "group_order": 4, "label": "Foreclosure Sale Date", "field_type": "date", "placeholder": "If known - date of scheduled foreclosure sale" },
    { "group_order": 4, "label": "Encumbrance Notes", "field_type": "text", "placeholder": "General notes on any debts, judgments, or title issues mentioned" },

    { "group_order": 5, "label": "Is Seller the Owner of Record?", "field_type": "select", "placeholder": "Is the seller the actual owner", "options": ["Yes", "No - acting on behalf of owner", "Partial owner", "Unknown"] },
    { "group_order": 5, "label": "Other Owners or Heirs?", "field_type": "select", "placeholder": "Additional parties on title", "options": ["Yes", "No", "Unknown"] },
    { "group_order": 5, "label": "Other Owners / Heirs Names", "field_type": "text_input", "placeholder": "Names of additional parties who must sign" },
    { "group_order": 5, "label": "All Parties Willing to Sell?", "field_type": "select", "placeholder": "Are all owners/heirs on board", "options": ["Yes", "No - one party reluctant", "Unknown"] },
    { "group_order": 5, "label": "Attorney or Executor Involved?", "field_type": "select", "placeholder": "Is there legal representation", "options": ["Yes - contact info noted", "No", "Unknown"] },
    { "group_order": 5, "label": "Attorney / Executor Name & Contact", "field_type": "text_input", "placeholder": "Name and phone/email if applicable" },
    { "group_order": 5, "label": "Property in Trust?", "field_type": "select", "placeholder": "Is property held in trust", "options": ["Yes", "No", "Unknown"] },
    { "group_order": 5, "label": "Trust Notes", "field_type": "text_input", "placeholder": "Name of trust, trustee info" },

    { "group_order": 6, "label": "Seller's Price Expectation Source", "field_type": "select", "placeholder": "Where did their number come from", "options": ["Zillow", "Redfin", "Agent told them", "Neighbor sold for", "Emotional", "Just a number", "Unknown"] },
    { "group_order": 6, "label": "Seller Open to Below-Market Offer?", "field_type": "select", "placeholder": "Flexibility on accepting below market", "options": ["Yes", "Possibly", "No", "Unknown"] },
    { "group_order": 6, "label": "Best Price Seller Would Accept", "field_type": "number", "placeholder": "If they hinted at a number below asking - capture it here" },
    { "group_order": 6, "label": "Preferred Closing Timeline", "field_type": "select", "placeholder": "Closing timeline preference", "options": ["7-14 days", "15-30 days", "30-60 days", "Flexible", "Needs time to move"] },
    { "group_order": 6, "label": "Cash or Finance Preference?", "field_type": "select", "placeholder": "Offer type preference", "options": ["Cash only", "Open to either", "Unknown"] },
    { "group_order": 6, "label": "How Did They Hear About Us?", "field_type": "select", "placeholder": "Lead source attribution", "options": ["Direct mail", "Text campaign", "Cold call", "Google", "Referral", "Website", "Other"] },
    { "group_order": 6, "label": "Deal Intelligence Notes", "field_type": "text", "placeholder": "Anything that would help make an offer: seller's emotional state, what they care about most, what would make them say yes" },

    { "group_order": 7, "label": "Photos on File?", "field_type": "select", "placeholder": "Photo collection status", "options": ["Yes - uploaded to record", "Yes - in text/email", "No - need to schedule"] },
    { "group_order": 7, "label": "Field Visit Scheduled?", "field_type": "select", "placeholder": "Has a field visit been scheduled", "options": ["Yes", "No", "Not Needed"] },
    { "group_order": 7, "label": "Field Visit Date", "field_type": "date", "placeholder": "Scheduled date for field visit" },
    { "group_order": 7, "label": "Who Will Be Present?", "field_type": "text_input", "placeholder": "Seller, tenant, TC, vacant, etc." },
    { "group_order": 7, "label": "Property Access", "field_type": "select", "placeholder": "Level of access to the property", "options": ["Full access", "Exterior only", "No access yet", "Tenant present"] },
    { "group_order": 7, "label": "Lockbox / Key Available?", "field_type": "select", "placeholder": "Access method for field visit", "options": ["Yes - have code", "Yes - key arranged", "No", "Unknown"] },
    { "group_order": 7, "label": "Lockbox Code", "field_type": "text_input", "placeholder": "Code if available" },
    { "group_order": 7, "label": "Field Visit Notes", "field_type": "text", "placeholder": "Anything the team needs to know before going out" }
  ]
}
